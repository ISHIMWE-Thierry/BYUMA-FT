# Your Firebase web app config. Copy this file to .env for local runs.
#
# These are not secrets — a web app ships them inside its own JavaScript.
# What guards the data is firestore.rules. See README section 5.
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_SENDER_ID=
VITE_FB_APP_ID=

# Set to 1 to point the app at the local emulators instead of the real
# project (npm run emulators).
# VITE_FB_EMULATOR=1
